# Copy to deploy/.env on the server and fill in. Never commit the real file.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
INTERNAL_API_SECRET=
GITHUB_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# Public hostnames Caddy serves. With no domain, use sslip.io names built from
# the server's IP, e.g. api.203-0-113-7.sslip.io and ws.203-0-113-7.sslip.io
API_HOST=
WS_HOST=
